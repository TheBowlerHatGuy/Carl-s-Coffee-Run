extends CharacterBody2D

# Assign your TileMapLayer (Godot 4.3+) or TileMap (Godot 4.0-4.2) in Inspector
@export var tile_map: TileMapLayer 

const SPEED: float = 300.0 # How fast the character glides between tiles

var target_position: Vector2
var is_moving: bool = false

# Hold delay settings
@export var hold_delay: float = 0.5 
var hold_time: float = 0.0
var has_tapped: bool = false
var last_input_dir: Vector2i = Vector2i.ZERO

func _ready() -> void:
	# Auto-find the TileMapLayer if it's not manually set in the Inspector
	if not tile_map:
		tile_map = get_tree().get_first_node_in_group("map") as TileMapLayer
		
		# Fallback search if groups aren't used:
		if not tile_map:
			tile_map = get_parent().find_child("*TileMapLayer*", true, false) as TileMapLayer
			
	snap_to_grid()

func _physics_process(delta: float) -> void:
	if is_moving:
		# Smoothly glide towards the target tile position
		global_position = global_position.move_toward(target_position, SPEED * delta)
		
		# Once the player arrives at their target tile, unlock movement again
		if global_position == target_position:
			is_moving = false
			
	get_input(delta)

func get_input(delta: float) -> void:
	var input_dir := Vector2i.ZERO
	
	if Input.is_action_pressed("ui_right"):
		input_dir = Vector2i.RIGHT
	elif Input.is_action_pressed("ui_left"):
		input_dir = Vector2i.LEFT
	elif Input.is_action_pressed("ui_down"):
		input_dir = Vector2i.DOWN
	elif Input.is_action_pressed("ui_up"):
		input_dir = Vector2i.UP

# Allow the player to hold directional keys to accelerate after a about a half second
	if input_dir != Vector2i.ZERO:
		if input_dir != last_input_dir:
			hold_time = 0.1
			has_tapped = false
			last_input_dir = input_dir

		if not has_tapped and not is_moving:
			has_tapped = true
			set_next_tile_target(input_dir)
			return

		hold_time += delta

		if hold_time >= hold_delay and not is_moving:
			set_next_tile_target(input_dir)
			
	else:
		hold_time = 0.0
		has_tapped = false
		last_input_dir = Vector2i.ZERO

func set_next_tile_target(dir: Vector2i) -> void:
	if not tile_map:
		push_warning("TileMap node is not assigned in the Inspector!")
		return
		
	# Convert current global position to TileMap local position
	var current_local_pos: Vector2 = tile_map.to_local(global_position)
	
	# Find current grid cell coordinates as integer vector (Vector2i)
	var current_map_cell: Vector2i = tile_map.local_to_map(current_local_pos)
	
	# Calculate target grid cell
	var target_map_cell: Vector2i = current_map_cell + dir
	
	# Check if the target tile is blocked by collision
	if is_tile_blocked(target_map_cell):
		return # Stop execution here so the player doesn't move
	
	# Convert target grid cell back to global pixel position
	var target_local_pos: Vector2 = tile_map.map_to_local(target_map_cell)
	target_position = tile_map.to_global(target_local_pos)
	
	is_moving = true

# Helper function to check for solid collision shapes on a tile
func is_tile_blocked(cell: Vector2i) -> bool:
	var tile_data: TileData = tile_map.get_cell_tile_data(cell)
	
	# If the tile exists and has a physics polygon defined on Physics Layer 0
	if tile_data and tile_data.get_collision_polygons_count(0) > 0:
		return true
		
	return false

func snap_to_grid() -> void:
	if not tile_map:
		return
		
	# Instantly snap player to the center of their current grid cell
	var current_local_pos: Vector2 = tile_map.to_local(global_position)
	var current_map_cell: Vector2i = tile_map.local_to_map(current_local_pos)
	
	var target_local_pos: Vector2 = tile_map.map_to_local(current_map_cell)
	
	global_position = tile_map.to_global(target_local_pos)
	target_position = global_position
